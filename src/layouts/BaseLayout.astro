---
import { Font } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import SkipLink from '../components/ui/SkipLink.astro';
import CustomCursor from '../components/ui/CustomCursor.jsx';
import Navbar from '../components/ui/Navbar.jsx';
import { createTranslator } from '../i18n/translate.js';
import '../styles/global.css';

const locale = Astro.currentLocale;
if (!locale) {
  throw new Error(`La página ${Astro.url.pathname} usa BaseLayout pero no está adentro de /en ni de /es.`);
}
const t = createTranslator(locale);

// La ruta de la página sin el idioma adelante: "" en la home,
// "projects/pulso-creativo" en un caso de estudio. Con ella se arma la misma
// página en el otro idioma y se sabe si estamos en la home.
const pathInsideLocale = Astro.url.pathname
  .replace(new RegExp(`^/${locale}(/|$)`), '')
  .replace(/\/$/, '');
const isHome = pathInsideLocale === '';

// Mismo orden que el selector del sitio anterior: EN primero. Cada idioma
// se nombra en su propio idioma ("English", "Español"), como recomienda el
// W3C para los selectores de idioma: quien busca su idioma lo reconoce aunque
// no entienda el de la página. Por eso estos dos no salen de los JSON.
const LANGUAGES = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Español' },
];
const languageLinks = LANGUAGES.map(({ code, label }) => ({
  code,
  label,
  href: getRelativeLocaleUrl(code, pathInsideLocale),
  current: code === locale,
}));
const homeHref = getRelativeLocaleUrl(locale);

// A la isla del Navbar se le pasan solo los textos que usa, visibles y
// accesibles (aria-label), ya traducidos.
const navbarTexts = {
  projects: t('nav.projects'),
  about: t('nav.about'),
  contactMarquee: t('nav.contact_marquee'),
  homeLink: t('a11y.home_link'),
  themeToLight: t('a11y.theme_to_light'),
  themeToDark: t('a11y.theme_to_dark'),
  menuOpen: t('a11y.menu_open'),
  menuClose: t('a11y.menu_close'),
  changeLanguage: t('a11y.change_language'),
};

if (!Astro.site) {
  throw new Error('Falta "site" en astro.config.mjs: Open Graph necesita la URL absoluta del sitio.');
}

const siteUrl = Astro.site.origin;
const ogImageUrl = new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang={locale} class="dark" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Pone el tema antes de que el navegador pinte la página. Tiene que ser
      inline y bloqueante: un <script> procesado por Astro es un módulo, y los
      módulos corren después de pintar, así que se vería un parpadeo de tema.
      Usa la misma clave ("theme") y los mismos valores que next-themes en el
      sitio anterior, así se conserva lo que cada visita ya eligió. Sin
      preferencia guardada, queda en oscuro. El comentario va acá afuera
      porque lo que está adentro de un is:inline se publica tal cual.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch (error) {}
        root.classList.remove('light', 'dark');
        root.classList.add(theme);
        root.style.colorScheme = theme;
      })();
    </script>

    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />

    <meta property="og:title" content={t('meta.og_title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={t('meta.site_name')} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.og_image_alt')} />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t('meta.og_title')} />
    <meta name="twitter:description" content={t('meta.description')} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={t('meta.og_image_alt')} />
    <meta name="twitter:image:type" content="image/png" />
    <meta name="twitter:image:width" content="1200" />
    <meta name="twitter:image:height" content="630" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />

    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <Font cssVariable="--font-space-grotesk" preload />
  </head>
  <body>
    <SkipLink />
    {/*
      client:load: el navbar está arriba de todo en todas las páginas, así
      que tiene que responder (menú, tema, NavLogo con el scroll) apenas
      carga la página.
    */}
    <Navbar
      client:load
      texts={navbarTexts}
      homeHref={homeHref}
      isHome={isHome}
      languageLinks={languageLinks}
    />
    <main id="main" tabindex="-1" class="pt-16 focus:outline-none">
      <slot />
    </main>

    {/*
      client:only porque el cursor depende del mouse y de la ventana, que no
      existen en el servidor: no hay nada útil que dibujar ahí. Las variantes
      las piden los elementos con data-cursor (ver CustomCursor.jsx).
    */}
    <CustomCursor client:only="react" />

    {/*
      Smooth scroll con Lenis (src/scripts/smoothScroll.js). Es un <script>
      procesado por Astro, que se empaqueta y se incluye una sola vez por
      página, y no una isla: no dibuja nada, así que no necesita React.
    */}
    <script>
      import '../scripts/smoothScroll.js';
    </script>
  </body>
</html>
