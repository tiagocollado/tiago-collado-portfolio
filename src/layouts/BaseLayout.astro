---
import { Font } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import SkipLink from '../components/ui/SkipLink.astro';
import CustomCursor from '../components/ui/CustomCursor.jsx';
import Navbar from '../components/ui/Navbar.jsx';
import { createTranslator } from '../i18n/translate.js';
import '../styles/global.css';

const locale = Astro.currentLocale ?? 'en';
const t = createTranslator(locale);

// "" en la home, "projects/pulso-creativo" en un caso.
const pathInsideLocale = Astro.url.pathname
  .replace(new RegExp(`^/${locale}(/|$)`), '')
  .replace(/\/$/, '');
const isHome = pathInsideLocale === '';

// Cada idioma se nombra en su propio idioma, como recomienda el W3C: por eso
// no salen de los JSON.
const LANGUAGES = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Español' },
];
const languageLinks = LANGUAGES.map(({ code, label }) => ({
  code,
  label,
  href: getRelativeLocaleUrl(code, pathInsideLocale),
  current: code === locale,
}));
const homeHref = getRelativeLocaleUrl(locale);

const navbarTexts = {
  projects: t('nav.projects'),
  about: t('nav.about'),
  contactMarquee: t('nav.contact_marquee'),
  homeLink: t('a11y.home_link'),
  themeToLight: t('a11y.theme_to_light'),
  themeToDark: t('a11y.theme_to_dark'),
  menuOpen: t('a11y.menu_open'),
  menuClose: t('a11y.menu_close'),
  changeLanguage: t('a11y.change_language'),
};

if (!Astro.site) {
  throw new Error('Falta "site" en astro.config.mjs: Open Graph necesita la URL absoluta del sitio.');
}

const siteUrl = Astro.site.origin;
const ogImageUrl = new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang={locale} class="dark" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Inline y bloqueante: un <script> de Astro es un módulo y corre después
        de pintar, y se vería un parpadeo de tema. La clave "theme" es la del
        sitio anterior. El comentario va afuera porque lo de adentro de un
        is:inline se publica tal cual. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch (error) {}
        root.classList.remove('light', 'dark');
        root.classList.add(theme);
        root.style.colorScheme = theme;
      })();
    </script>

    {/* Sin JavaScript, los bloques con data-reveal quedarían en opacidad 0.
        is:inline deja el <style> adentro del <noscript>. */}
    <noscript>
      <style is:inline>
        [data-reveal] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />

    <meta property="og:title" content={t('meta.og_title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={t('meta.site_name')} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.og_image_alt')} />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t('meta.og_title')} />
    <meta name="twitter:description" content={t('meta.description')} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={t('meta.og_image_alt')} />
    <meta name="twitter:image:type" content="image/png" />
    <meta name="twitter:image:width" content="1200" />
    <meta name="twitter:image:height" content="630" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />

    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <Font cssVariable="--font-space-grotesk" preload />
  </head>
  <body>
    <SkipLink />
    <Navbar
      client:load
      texts={navbarTexts}
      homeHref={homeHref}
      isHome={isHome}
      languageLinks={languageLinks}
    />
    <main id="main" tabindex="-1" class="pt-16 focus:outline-none">
      <slot />
    </main>

    {/* client:only: sin mouse ni ventana, en el servidor no hay nada que
        dibujar. */}
    <CustomCursor client:only="react" viewLabel={t('cursor.view')} />

    <script>
      import '../scripts/smoothScroll.js';
    </script>
  </body>
</html>
