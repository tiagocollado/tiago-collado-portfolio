---
import NowPlaying from './NowPlaying.jsx';
import { createTranslator } from '../../i18n/translate.js';

const t = createTranslator(Astro.currentLocale);

// La isla recibe solo los textos que usa, ya traducidos.
const nowPlayingTexts = {
  label: t('now_playing.label'),
  tab_now: t('now_playing.tab_now'),
  tab_recent: t('now_playing.tab_recent'),
  status_playing: t('now_playing.status_playing'),
  status_recent: t('now_playing.status_recent'),
  loading: t('now_playing.loading'),
  empty: t('now_playing.empty'),
  private: t('now_playing.private'),
  error: t('now_playing.error'),
  credit: t('now_playing.credit'),
  track_link: t('now_playing.track_link'),
};

/*
 * Espacio duro entre fragmentos del claim. En ES esas uniones son "el diseño"
 * y "al negocio": un salto de línea ahí dejaría el artículo solo al final
 * del renglón. text-pretty corta por largo de línea, no por gramática, así
 * que el corte bueno se fija a mano y aguanta cualquier ancho de pantalla.
 * Va con nombre y escapado porque el carácter literal no se distingue de un
 * espacio común al leer el archivo.
 */
const NO_BREAK_SPACE = '\u00a0';
---

{/*
  Entrada: cuatro bloques con fade + subida, cada uno cuando entra en
  pantalla (margen -80px): la fila de labels, el claim, el copy con la firma
  y el widget de música. Esperan 0, 0.1, 0.15 y 0.2 s, así en una pantalla
  alta, donde entran juntos, se leen en orden.
*/}
<section
  id="about"
  aria-labelledby="about-heading"
  class="pt-16 md:pt-20 lg:pt-28 pb-8 md:pb-10 lg:pb-12 px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32"
>
  <div class="max-w-7xl mx-auto">
    <div
      class="flex items-start justify-between gap-6"
      data-reveal-trigger
      data-reveal-margin="-80px"
      data-reveal
      style="--reveal-y: 12px; --reveal-duration: 0.6s;"
    >
      <h2
        id="about-heading"
        class="text-xs font-mono tracking-[0.2em] uppercase"
        style="color: var(--color-accent);"
      >
        {t('about.title')}
      </h2>
      <p
        class="text-xs font-mono tracking-[0.2em] uppercase text-right"
        style="color: var(--ink-muted);"
      >
        {t('about.based')}
      </p>
    </div>

    <p
      class="font-display text-3xl md:text-4xl lg:text-5xl leading-[1.15] tracking-tight max-w-4xl mt-12 md:mt-16 lg:mt-20 text-pretty"
      data-reveal-trigger
      data-reveal-margin="-80px"
      data-reveal
      style="color: var(--ink-primary); --reveal-y: 24px; --reveal-duration: 0.7s; --reveal-delay: 0.1s;"
    >
      {t('about.claim_1')}{NO_BREAK_SPACE}<strong class="font-semibold">{t('about.claim_2')}</strong>{' '}{t('about.claim_3')}{NO_BREAK_SPACE}<strong class="font-semibold">{t('about.claim_4')}</strong>
    </p>

    {/*
      Copy con la firma y widget de música. El copy va primero en el DOM:
      es lo principal de la sección y así encabeza el apilado en mobile y el
      orden de tabulación. En lg el widget pasa a la columna izquierda, que
      sin él queda vacía bajo el claim (order).

      items-start, no items-end: cuando el widget muestra los últimos cinco
      temas y crece, solo se estira hacia abajo y el copy de la derecha no se
      mueve.
    */}
    <div class="flex flex-col gap-16 lg:flex-row lg:items-start lg:justify-between mt-16 md:mt-20 lg:mt-24">
      <div
        class="max-w-xl space-y-6 md:text-right md:self-end lg:order-2"
        data-reveal-trigger
        data-reveal-margin="-80px"
        data-reveal
        style="--reveal-y: 24px; --reveal-duration: 0.7s; --reveal-delay: 0.15s;"
      >
        <p class="text-base md:text-lg leading-relaxed text-pretty" style="color: var(--ink-secondary);">
          {t('about.body_1')}
        </p>
        <p class="text-base md:text-lg leading-relaxed text-pretty" style="color: var(--ink-secondary);">
          {t('about.body_2')}
        </p>
        <div class="pt-2">
          <p class="font-display text-xl md:text-2xl font-semibold" style="color: var(--ink-primary);">
            {t('about.signature')}
          </p>
          <p
            class="text-xs font-mono tracking-[0.2em] uppercase mt-3"
            style="color: var(--ink-muted);"
          >
            {t('about.byline')}
          </p>
        </div>
      </div>

      {/*
        Widget de música. Sin JavaScript no puede pedir los datos y se
        quedaría en "cargando" para siempre, así que se oculta (el <noscript>
        de abajo). data-now-playing es el gancho de esa regla.
      */}
      <div
        class="w-full max-w-sm md:self-end lg:self-auto lg:order-1"
        data-now-playing
        data-reveal-trigger
        data-reveal-margin="-80px"
        data-reveal
        style="--reveal-y: 24px; --reveal-duration: 0.7s; --reveal-delay: 0.2s;"
      >
        <NowPlaying client:visible texts={nowPlayingTexts} locale={Astro.currentLocale} />
      </div>
    </div>
  </div>
</section>

<noscript>
  <style is:inline>
    [data-now-playing] { display: none; }
  </style>
</noscript>

<script>
  import '../../scripts/reveal.js';
</script>
