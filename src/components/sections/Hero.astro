---
import { getRelativeLocaleUrl } from 'astro:i18n';
import HeroContent from './HeroContent.jsx';
import InteractiveDotGrid from '../ui/InteractiveDotGrid.jsx';
import { createTranslator } from '../../i18n/translate.js';

const locale = Astro.currentLocale ?? 'en';
const t = createTranslator(locale);

const heroTexts = {
  headline: t('hero.headline'),
  subheadline: t('hero.subheadline'),
  ctaProjects: t('hero.cta_projects'),
  homeLink: t('a11y.home_link'),
};

// Los usan la grilla y la fila del pie, para que no puedan quedar distintas.
const DOT_SPACING = 32; // px
const DOT_RADIUS = 1.2; // px
const DOT_OPACITY = 0.7;
// --ink-secondary y no el --ink-subtle que la grilla usa por defecto: sobre el
// beige del tema claro, el subtle casi no se distingue del fondo.
const DOT_COLOR_VAR = '--ink-secondary';

const dotRowStyle = [
  `--dot-spacing: ${DOT_SPACING}px`,
  `--dot-radius: ${DOT_RADIUS}px`,
  `--dot-color: var(${DOT_COLOR_VAR})`,
  `opacity: ${DOT_OPACITY}`,
].join('; ');
---

{/* id="top": destino del back-to-top del Footer; sin él, el botón no hace
    nada y nada lo avisa. -mt-16 sube la sección detrás del navbar fijo, así
    la grilla cubre desde arriba. La grilla es fondo: puede esperar a
    client:idle. */}
<section
  id="top"
  class="min-h-screen flex flex-col px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32 pb-8 md:pb-10 lg:pb-12 relative overflow-hidden -mt-16 pt-40 md:pt-48 lg:pt-56"
>
  <InteractiveDotGrid
    client:idle
    spacing={DOT_SPACING}
    dotRadius={DOT_RADIUS}
    opacity={DOT_OPACITY}
    colorVar={DOT_COLOR_VAR}
  />

  <HeroContent client:load texts={heroTexts} homeHref={getRelativeLocaleUrl(locale)} />
</section>

{/* Fuera de la <section>, para no pisarse con las filas de la grilla. */}
<div class="hero-dot-row" style={dotRowStyle} aria-hidden="true">
  <span class="hero-dot-row-dots"></span>
</div>

<style>
  .hero-dot-row {
    position: relative;
    height: var(--dot-spacing);
    overflow: hidden;
    pointer-events: none;
  }

  /*
   * Mismas columnas que el canvas: buildGrid() pone el primer punto en
   * (ancho - ceil(ancho / 32) * 32) / 2. Esta capa mide
   * round(up, 100%, 32px) + 32px y se centra, así el punto del medio de cada
   * cuadro cae en el mismo lugar. La primera línea de width es el respaldo
   * sin round(): las columnas se corren hasta 16px.
   */
  .hero-dot-row-dots {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: calc(100% + var(--dot-spacing));
    width: calc(round(up, 100%, var(--dot-spacing)) + var(--dot-spacing));
    transform: translateX(-50%);
    background-image: radial-gradient(
      circle,
      var(--dot-color) var(--dot-radius),
      transparent var(--dot-radius)
    );
    background-size: var(--dot-spacing) var(--dot-spacing);
    background-repeat: repeat-x;
  }

  /* En táctil la grilla es CSS y arranca del borde izquierdo: la fila también. */
  @media (pointer: coarse) {
    .hero-dot-row-dots {
      left: 0;
      width: 100%;
      transform: none;
    }
  }
</style>
