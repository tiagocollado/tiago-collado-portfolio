---
import { getRelativeLocaleUrl } from 'astro:i18n';
import HeroContent from './HeroContent.jsx';
import InteractiveDotGrid from '../ui/InteractiveDotGrid.jsx';
import { createTranslator } from '../../i18n/translate.js';

const locale = Astro.currentLocale ?? 'en';
const t = createTranslator(locale);

const heroTexts = {
  headline: t('hero.headline'),
  subheadline: t('hero.subheadline'),
  ctaProjects: t('hero.cta_projects'),
  homeLink: t('a11y.home_link'),
};

// Los puntos de la grilla y los de la fila del pie son los mismos: estos
// valores van a los dos lados para que no puedan quedar distintos.
const DOT_SPACING = 32; // px
const DOT_RADIUS = 1.2; // px
const DOT_OPACITY = 0.7;
// --ink-secondary y no el --ink-muted que la grilla usa por defecto: sobre el
// beige del tema claro, el muted casi no se distingue del fondo.
const DOT_COLOR_VAR = '--ink-secondary';

const dotRowStyle = [
  `--dot-spacing: ${DOT_SPACING}px`,
  `--dot-radius: ${DOT_RADIUS}px`,
  `--dot-color: var(${DOT_COLOR_VAR})`,
  `opacity: ${DOT_OPACITY}`,
].join('; ');
---

{/*
  La sección es HTML estático; adentro van dos islas con directivas
  distintas, porque no necesitan su JavaScript al mismo tiempo:

  - InteractiveDotGrid, client:idle: es fondo. Se ve igual antes de hidratar
    (los puntos aparecen al montar), así que puede esperar a que el
    navegador termine lo urgente.
  - HeroContent, client:load: el wordmark y el lema animan apenas se abre
    la página y el wordmark sigue al scroll desde el primer momento.

  id="top" es el destino del back-to-top del Footer. Sin este id el botón
  no hace nada y no hay ningún error que lo avise.

  -mt-16 y el pt grande suben la sección por detrás del navbar fijo, para
  que la grilla de puntos cubra desde el borde de arriba de la pantalla.
*/}
<section
  id="top"
  class="min-h-screen flex flex-col px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32 pb-8 md:pb-10 lg:pb-12 relative overflow-hidden -mt-16 pt-40 md:pt-48 lg:pt-56"
>
  <InteractiveDotGrid
    client:idle
    spacing={DOT_SPACING}
    dotRadius={DOT_RADIUS}
    opacity={DOT_OPACITY}
    colorVar={DOT_COLOR_VAR}
  />

  <HeroContent client:load texts={heroTexts} homeHref={getRelativeLocaleUrl(locale)} />
</section>

{/*
  Fila de puntos al pie del hero: la grilla condensada en una sola línea.
  La grilla se apaga al scrollear; esta fila queda y marca dónde termina el
  hero. Es decorativa (aria-hidden) y es solo CSS, así que se ve igual con
  mouse, en táctil y sin JavaScript.

  Mide un cuadro de alto (32px) y el punto queda en el medio. Va afuera de
  la <section> para que no se pise con las filas de la grilla, que la
  sección recorta con overflow-hidden.
*/}
<div class="hero-dot-row" style={dotRowStyle} aria-hidden="true">
  <span class="hero-dot-row-dots"></span>
</div>

<style>
  .hero-dot-row {
    position: relative;
    height: var(--dot-spacing);
    overflow: hidden;
    pointer-events: none;
  }

  /*
   * Un punto en el centro de cada cuadro de 32px, repetido solo a lo ancho.
   *
   * Columnas alineadas con el canvas (con mouse): buildGrid() en
   * InteractiveDotGrid reparte las columnas centradas, con el primer punto
   * en (ancho - redondeoArriba(ancho, 32)) / 2. Para que el CSS caiga en el
   * mismo lugar, esta capa mide redondeoArriba(ancho, 32) + 32 y se centra:
   * su borde izquierdo queda 16px antes del primer punto del canvas, y como
   * cada punto está en el medio de su cuadro (a 16px del borde), coinciden.
   * round(up, …) hace en CSS lo mismo que Math.ceil en el canvas.
   *
   * La primera línea de width es el respaldo para navegadores sin round():
   * la fila se ve igual, con las columnas corridas hasta 16px.
   */
  .hero-dot-row-dots {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: calc(100% + var(--dot-spacing));
    width: calc(round(up, 100%, var(--dot-spacing)) + var(--dot-spacing));
    transform: translateX(-50%);
    background-image: radial-gradient(
      circle,
      var(--dot-color) var(--dot-radius),
      transparent var(--dot-radius)
    );
    background-size: var(--dot-spacing) var(--dot-spacing);
    background-repeat: repeat-x;
  }

  /*
   * En táctil no hay canvas: la grilla es CSS y sus puntos arrancan desde el
   * borde izquierdo de la sección. La fila arranca igual. Es la misma
   * consulta que usa InteractiveDotGrid para elegir entre canvas y CSS.
   */
  @media (pointer: coarse) {
    .hero-dot-row-dots {
      left: 0;
      width: 100%;
      transform: none;
    }
  }
</style>
