---
import { createTranslator } from '../../i18n/translate.js';

const t = createTranslator(Astro.currentLocale);
const services = t.list('services.items');
---

<section
  aria-label={t('services.label')}
  class="relative overflow-hidden py-8 md:py-10 lg:py-12"
  style="background-color: var(--ink-primary); color: var(--bg-primary);"
>
  <div
    class="services-marquee-track flex whitespace-nowrap font-display font-semibold tracking-tight text-2xl md:text-4xl lg:text-5xl"
    aria-hidden="true"
  >
    {[0, 1].map(() => (
      <span class="flex items-center shrink-0">
        {services.map((service) => (
          <span class="flex items-center shrink-0">
            <span class="px-6 md:px-8 lg:px-10">{service}</span>
            <span aria-hidden="true" style="color: var(--color-accent);">•</span>
          </span>
        ))}
      </span>
    ))}
  </div>
</section>

<style>
  .services-marquee-track {
    width: max-content;
    animation: services-marquee 40s linear infinite;
  }

  @keyframes services-marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-marquee-track {
      animation: none;
    }
  }
</style>
