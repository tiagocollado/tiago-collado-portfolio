---
import ToolIcon from '../ui/ToolIcon.astro';
import { createTranslator } from '../../i18n/translate.js';
import { stack, stackGroups } from '../../data/stack.js';

const locale = Astro.currentLocale ?? 'en';
const t = createTranslator(locale);

// Un bloque por grupo, en el orden de stackGroups, con sus herramientas en
// el orden de stack.js. El nombre del grupo va como subtítulo, así que no se
// repite en cada herramienta.
const groups = Object.values(stackGroups).map((group) => ({
  label: locale === 'es' ? group.es : group.en,
  tools: stack.filter((tool) => tool.group === group).map((tool) => tool.name),
}));
---

{/*
  Herramientas agrupadas, en una grilla quieta: 2 columnas en celular, 3 en
  tablet y 4 en escritorio. Las tarjetas no son clickeables, así que no
  tienen hover ni cursor de link.
*/}
<section
  aria-labelledby="stack-heading"
  class="pt-16 md:pt-20 lg:pt-28 pb-16 md:pb-20 lg:pb-28 px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32"
>
  <div class="max-w-7xl mx-auto">
    <h2
      id="stack-heading"
      class="text-xs font-mono tracking-[0.2em] uppercase"
      style="color: var(--color-accent); --reveal-y: 12px; --reveal-duration: 0.6s;"
      data-reveal-trigger
      data-reveal-margin="-80px"
      data-reveal
    >
      {t('stack.label')}
    </h2>

    <div class="mt-8 md:mt-10 space-y-10 md:space-y-12">
      {groups.map((group) => (
        <div
          data-reveal-trigger
          data-reveal-margin="-80px"
          data-reveal
          style="--reveal-duration: 0.7s;"
        >
          <h3
            class="text-xs font-mono tracking-[0.2em] uppercase"
            style="color: var(--ink-secondary);"
          >
            {group.label}
          </h3>
          <ul class="mt-4 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
            {group.tools.map((tool) => (
              <li
                class="flex items-center gap-3 min-w-0 px-4 py-3 md:px-5 md:py-4 rounded-xl border border-(--border-default)"
                style="background-color: var(--color-surface);"
              >
                <span class="flex shrink-0" style="color: var(--ink-secondary);">
                  <ToolIcon name={tool} size={20} />
                </span>
                <span
                  class="min-w-0 font-medium text-sm md:text-base leading-snug"
                  style="color: var(--ink-primary);"
                >
                  {tool}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import '../../scripts/reveal.js';
</script>
