---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ProjectCard from './ProjectCard.jsx';
import SplitText from '../ui/SplitText.jsx';
import { createTranslator } from '../../i18n/translate.js';
import { publishedProjects } from '../../data/projects.js';
import { SIZES_COVER, SIZES_COVER_PORTRAIT } from '../case-study/imageSpec.js';
import { getResponsiveImageProps } from '../../utils/responsiveImage.js';

// 'es' o 'en' y no un string cualquiera: así el editor acepta
// project.services[locale] sin marcar "any implícito".
const locale = Astro.currentLocale === 'es' ? 'es' : 'en';
const t = createTranslator(locale);

const homeProjects = publishedProjects.filter((project) => project.showOnHome);

const cards = await Promise.all(
  homeProjects.map(async (project, gridPosition) => ({
    href: getRelativeLocaleUrl(locale, `projects/${project.slug}`),
    title: project.title,
    servicesLabel: project.services[locale].join(' & '),
    awardLabel: project.award?.[locale] ?? null,
    cardShape: project.cardShape,
    coverImage: project.coverImage
      ? await getResponsiveImageProps(
          project.coverImage,
          project.cardShape === 'portrait' ? SIZES_COVER_PORTRAIT : SIZES_COVER
        )
      : null,
    gridPosition,
  }))
);

/*
 * Masonry: dos columnas que alternan proyectos (column-count llenaría una
 * antes de pasar a la otra). En mobile las columnas son display: contents y
 * el `order` de cada card restituye el orden de lectura 1·2·3.
 */
const columns = [
  cards.filter((_, index) => index % 2 === 0),
  cards.filter((_, index) => index % 2 === 1),
];
---

<section id="projects" class="py-16 md:py-20 lg:py-28 px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32">
  <div class="max-w-7xl mx-auto">
    {/* El rootMargin de 200px hidrata la isla del h2 antes de que llegue,
        así su observer ya escucha cuando el título entra. */}
    <div>
      <p
        class="text-xs font-mono tracking-[0.2em] mb-6 uppercase"
        data-reveal-trigger
        data-reveal-margin="-50px"
        data-reveal
        style="color: var(--color-accent); --reveal-y: 16px; --reveal-duration: 0.5s;"
      >
        {t('projects.label')}
      </p>
      <SplitText
        client:visible={{ rootMargin: '200px' }}
        as="h2"
        text={t('projects.statement')}
        stagger={0.015}
        delay={0.15}
        yFrom={20}
        blurFrom={4}
        duration={0.6}
        whileInView
        className="font-display text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.1] block text-(--ink-primary)"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 mt-12 md:mt-16">
      {columns.map((column) => (
        <div class="contents md:flex md:flex-col md:gap-6">
          {column.map((card) => (
            <ProjectCard
              client:visible
              {...card}
              viewProjectLabel={t('projects.view_project')}
            />
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import '../../scripts/reveal.js';
</script>
