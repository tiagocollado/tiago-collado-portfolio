---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ProjectCard from './ProjectCard.jsx';
import { createTranslator } from '../../i18n/translate.js';
import { publishedProjects } from '../../data/projects.js';
import { SIZES_COVER } from '../case-study/imageSpec.js';
import { getResponsiveImageProps } from '../../utils/responsiveImage.js';

const locale = Astro.currentLocale;
const t = createTranslator(locale);

const homeProjects = publishedProjects.filter((project) => project.showOnHome);

const cards = await Promise.all(
  homeProjects.map(async (project, gridPosition) => ({
    href: getRelativeLocaleUrl(locale, `projects/${project.slug}`),
    title: project.title,
    servicesLabel: project.services[locale].join(' & '),
    cardShape: project.cardShape,
    coverImage: project.coverImage
      ? await getResponsiveImageProps(project.coverImage, SIZES_COVER)
      : null,
    gridPosition,
  }))
);

/*
 * Masonry en dos columnas, repartiendo los proyectos ALTERNADOS: el 1 y el 3
 * a la izquierda, el 2 a la derecha. Cada columna fluye sola y terminan a
 * distinta altura, que es lo que la hace masonry (una grilla con row-span
 * alinearía las filas, y `column-count` llena una columna antes de pasar a la
 * otra en vez de alternar).
 *
 * En mobile, alternar dejaría el orden de lectura 1·3·2 (el orden del DOM).
 * Por eso abajo de `md` las columnas son `display: contents`: desaparecen del
 * layout, las cards pasan a ser hijas directas del grid y el `order` de cada
 * una (ver ProjectCard) las ordena 1·2·3. En desktop vuelven a ser `flex`.
 */
const columns = [
  cards.filter((_, index) => index % 2 === 0),
  cards.filter((_, index) => index % 2 === 1),
];
---

<section id="projects" class="py-16 md:py-20 lg:py-28 px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32">
  <div class="max-w-7xl mx-auto">
    <div>
      <p
        class="text-xs font-mono tracking-[0.2em] mb-6 uppercase"
        style="color: var(--color-accent);"
      >
        {t('projects.label')}
      </p>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-[1.1] block text-(--ink-primary)">
        {t('projects.statement')}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 mt-12 md:mt-16">
      {columns.map((column) => (
        <div class="contents md:flex md:flex-col md:gap-6">
          {column.map((card) => (
            <ProjectCard
              client:visible
              {...card}
              viewProjectLabel={t('projects.view_project')}
            />
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
