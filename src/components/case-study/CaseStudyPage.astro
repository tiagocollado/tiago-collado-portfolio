---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyHeader from './CaseStudyHeader.astro';
import CaseStudyMetaBar from './CaseStudyMetaBar.astro';
import CaseStudySection from './CaseStudySection.astro';
import CaseStudyImageRun from './CaseStudyImageRun.astro';
import CaseStudyNextNav from './CaseStudyNextNav.astro';
import Footer from '../ui/Footer.jsx';
import { createTranslator } from '../../i18n/translate.js';
import { publishedProjects } from '../../data/projects.js';

const { project } = Astro.props;
const locale = Astro.currentLocale;
const t = createTranslator(locale);

const textKey = (key) => `case_study_${project.slug}.${key}`;

const REQUIRED_TEXT_KEYS = [
  'intro',
  'challenge',
  'decision_1_title', 'decision_1_body',
  'decision_2_title', 'decision_2_body',
  'decision_3_title', 'decision_3_body',
  'delivered_1', 'delivered_2', 'delivered_3',
  'closing',
];

const hasCaseStudyText = REQUIRED_TEXT_KEYS.every((key) => t.has(textKey(key)));
const caseStudyText = hasCaseStudyText
  ? Object.fromEntries(REQUIRED_TEXT_KEYS.map((key) => [key, t(textKey(key))]))
  : {};
const processText = t.has(textKey('process')) ? t(textKey('process')) : null;

const imagesInSlot = (slot) =>
  (project.imageBriefs ?? []).filter((brief) => brief.slot === slot && brief.src);

const currentPosition = publishedProjects.findIndex((published) => published.slug === project.slug);
const nextProject = publishedProjects[(currentPosition + 1) % publishedProjects.length];

const ITEM_NUMBERS = [1, 2, 3];

const footerTexts = {
  credit: t('footer.credit'),
  backToTop: t('footer.back_to_top'),
};
---

<BaseLayout>
  <div id="top" class="min-h-screen">
    <div class="pt-16 md:pt-20">
      <div class="px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32">
        <div class="max-w-7xl mx-auto">
          <CaseStudyHeader project={project} />
        </div>
      </div>
    </div>

    {hasCaseStudyText && (
      <div class="mt-12 md:mt-16 flex flex-col gap-20 md:gap-28">
        <CaseStudyImageRun briefs={imagesInSlot('hero')} locale={locale} isHeroSlot />

        <div class="px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32">
          <div class="max-w-7xl mx-auto">
            <CaseStudySection>
              <p
                class="font-display text-2xl md:text-3xl lg:text-4xl leading-tight tracking-tight max-w-3xl text-balance"
                style="color: var(--ink-primary);"
              >
                {caseStudyText.intro}
              </p>
            </CaseStudySection>
          </div>
        </div>

        <div class="md:order-first">
          <div class="px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32">
            <div class="max-w-7xl mx-auto">
              <CaseStudyMetaBar project={project} />
            </div>
          </div>
        </div>

        <CaseStudyImageRun briefs={imagesInSlot('intro')} locale={locale} />

        <div class="px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32">
          <div class="max-w-7xl mx-auto">
            <CaseStudySection label={t('case_study.cs_challenge')}>
              <div class="max-w-2xl space-y-6">
                {caseStudyText.challenge.split('\n\n').map((paragraph) => (
                  <p class="text-lg md:text-xl leading-relaxed text-pretty" style="color: var(--ink-secondary);">
                    {paragraph}
                  </p>
                ))}
              </div>
            </CaseStudySection>
          </div>
        </div>
        <CaseStudyImageRun briefs={imagesInSlot('challenge')} locale={locale} />

        <div class="px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32">
          <div class="max-w-7xl mx-auto">
            <CaseStudySection label={t('case_study.cs_decisions')}>
              {processText && (
                <p class="text-lg md:text-xl leading-relaxed max-w-2xl text-pretty" style="color: var(--ink-secondary);">
                  {processText}
                </p>
              )}
              <ol class="space-y-12 md:space-y-16 list-none">
                {ITEM_NUMBERS.map((number) => (
                  <li class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
                    <span class="md:col-span-1 text-xs font-mono" style="color: var(--color-accent);">
                      0{number}
                    </span>
                    <div class="md:col-span-11 space-y-3">
                      <h3 class="font-display text-xl md:text-2xl tracking-tight text-balance" style="color: var(--ink-primary);">
                        {caseStudyText[`decision_${number}_title`]}
                      </h3>
                      <p class="text-base md:text-lg leading-relaxed max-w-2xl text-pretty" style="color: var(--ink-secondary);">
                        {caseStudyText[`decision_${number}_body`]}
                      </p>
                    </div>
                  </li>
                ))}
              </ol>
            </CaseStudySection>
          </div>
        </div>
        <CaseStudyImageRun briefs={imagesInSlot('decisions')} locale={locale} />

        <div class="px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32">
          <div class="max-w-7xl mx-auto">
            <CaseStudySection label={t('case_study.cs_delivered')}>
              <ul class="space-y-4 list-none max-w-2xl">
                {ITEM_NUMBERS.map((number) => (
                  <li class="flex gap-4 items-baseline pb-4 border-b" style="border-color: var(--border-default);">
                    <span aria-hidden="true" class="text-xs font-mono shrink-0" style="color: var(--color-accent);">
                      →
                    </span>
                    <span class="text-base md:text-lg font-display" style="color: var(--ink-primary);">
                      {caseStudyText[`delivered_${number}`]}
                    </span>
                  </li>
                ))}
              </ul>
            </CaseStudySection>
          </div>
        </div>
        <CaseStudyImageRun briefs={imagesInSlot('delivered')} locale={locale} />

        <div class="px-6 md:px-10 lg:px-16 xl:px-24 2xl:px-32">
          <div class="max-w-7xl mx-auto">
            <CaseStudySection label={t('case_study.cs_closing')}>
              <p class="text-lg md:text-xl leading-relaxed max-w-2xl text-pretty" style="color: var(--ink-secondary);">
                {caseStudyText.closing}
              </p>
            </CaseStudySection>
          </div>
        </div>
        <CaseStudyImageRun briefs={imagesInSlot('end')} locale={locale} />
      </div>
    )}

    <CaseStudyNextNav nextProject={nextProject} />

    {/* client:visible: está al pie de una página larga y solo anima al
        entrar en pantalla. Su back-to-top apunta al id="top" de este div. */}
    <Footer client:visible texts={footerTexts} />
  </div>
</BaseLayout>
