---
import { Sparkles, Search, Wand2, Blocks, Contrast, PenLine } from 'lucide-react';
import {
  siFigma,
  siReact,
  siNextdotjs,
  siAstro,
  siTailwindcss,
  siHtml5,
  siCss,
  siGithub,
} from 'simple-icons';

const BRAND_ICONS = {
  'Figma':        siFigma,
  'React':        siReact,
  'Next.js':      siNextdotjs,
  'Astro':        siAstro,
  'Tailwind CSS': siTailwindcss,
  'HTML5':        siHtml5,
  'CSS3':         siCss,
  'Git / GitHub': siGithub,
};

const ADOBE_INITIALS = {
  'Adobe Photoshop':   'Ps',
  'Adobe Illustrator': 'Ai',
  'Adobe Premiere':    'Pr',
};

const CONCEPT_ICONS = {
  'FigJam':         PenLine,
  'IA Generativa':  Sparkles,
  'UX Research':    Search,
  'Prototyping':    Wand2,
  'Design Systems': Blocks,
  'Accessibility':  Contrast,
};

const { name, size = 18 } = Astro.props;

const adobeInitials = ADOBE_INITIALS[name];
const ConceptIcon = CONCEPT_ICONS[name];
const brandIcon = BRAND_ICONS[name];
---

{adobeInitials ? (
  <span
    aria-hidden="true"
    class="inline-flex items-center justify-center rounded-[3px] border font-bold leading-none"
    style={`width: ${size}px; height: ${size}px; border-color: currentColor; color: currentColor; font-size: ${size * 0.5}px; font-family: system-ui, sans-serif;`}
  >
    {adobeInitials}
  </span>
) : ConceptIcon ? (
  <ConceptIcon size={size} />
) : brandIcon ? (
  <svg
    role="img"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="currentColor"
    aria-hidden="true"
  >
    <path d={brandIcon.path} />
  </svg>
) : null}
